# Public app display name (optional; defaults to Kirana B2B Marketplace).
VITE_APP_NAME=Kirana B2B Marketplace
# Payment simulation only; this project does not take real payments.
VITE_PAYMENT_PROVIDER=mock

# Public Supabase project URL (leave empty with the anon key to use demo mode).
VITE_SUPABASE_URL=
# Public Supabase anon key; never put the service-role key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase service role key, used by the seed script and mock-payment Netlify Function.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Server-only provider selector for Netlify Functions. This mock has no real-money capability.
PAYMENT_PROVIDER=mock
# Super admin credentials consumed by the demo seed script.
ADMIN_EMAIL=admin@kirana.local
ADMIN_PASSWORD=replace-me

# Maximum allowed COD order amount in INR.
VITE_COD_ORDER_CAP=5000
# Whether profile completion is required before listing or ordering.
VITE_PROFILE_COMPLETION_REQUIRED=true
